<script>
  function toggleInstr() {
    var body = document.getElementById('instrBody');
    var toggle = document.getElementById('instrToggle');
    var collapsed = body.classList.toggle('collapsed');
    toggle.textContent = collapsed ? '&#9654; Expand' : '&#9660; Collapse';
  }

  var currentTab = 'anat';

  function switchTab(tab) {
    currentTab = tab;
    document.getElementById('panel-anat').classList.toggle('active', tab === 'anat');
    document.getElementById('panel-phys').classList.toggle('active', tab === 'phys');
    document.getElementById('tabAnat').className = 'tab-btn' + (tab === 'anat' ? ' active-anat' : '');
    document.getElementById('tabPhys').className = 'tab-btn' + (tab === 'phys' ? ' active-phys' : '');
    document.getElementById('rubricStrip').style.display = tab === 'anat' ? '' : 'none';
    var fill = document.getElementById('globalFill');
    fill.className = 'progress-fill ' + (tab === 'anat' ? 'anat-fill' : 'phys-fill');
    document.getElementById('progressLabel').textContent = tab === 'anat' ? 'Anatomy Progress' : 'Physiology Progress';
    updateProgress();
  }

  function toggleRegion(header) {
    var isOpen = header.classList.contains('open');
    header.classList.toggle('open', !isOpen);
    header.nextElementSibling.classList.toggle('open', !isOpen);
  }

  function toggleCheck(item, mode) {
    item.classList.toggle('checked-' + mode);
    updateProgress();
  }

  function updateProgress() {
    var panel = document.getElementById('panel-' + currentTab);
    var allItems = panel.querySelectorAll('.check-item, .feedback-row');
    var checkedItems = panel.querySelectorAll('.checked-' + currentTab);
    var total = allItems.length;
    var checked = checkedItems.length;
    var pct = total ? Math.round((checked / total) * 100) : 0;
    document.getElementById('globalFill').style.width = pct + '%';
    document.getElementById('globalCount').textContent = checked + ' / ' + total;

    panel.querySelectorAll('.region-group').forEach(function(group) {
      var rItems = group.querySelectorAll('.check-item, .feedback-row');
      var rChecked = group.querySelectorAll('.checked-' + currentTab);
      var rPct = rItems.length ? Math.round((rChecked.length / rItems.length) * 100) : 0;
      var fill = group.querySelector('.region-mini-fill');
      var label = group.querySelector('.region-progress-text');
      if (fill) fill.style.width = rPct + '%';
      if (label) label.textContent = rPct + '%';
    });

    if (currentTab === 'anat') updateRubricPills();
  }

  function updateRubricPills() {
    var panel = document.getElementById('panel-anat');
    var cats = {anatomy:0,histo:0,neural:0,function:0,cells:0,secrete:0};
    var totals = {anatomy:0,histo:0,neural:0,function:0,cells:0,secrete:0};
    panel.querySelectorAll('.check-item').forEach(function(item) {
      (item.dataset.cats||'').split(' ').forEach(function(c){if(totals[c]!==undefined)totals[c]++;});
    });
    panel.querySelectorAll('.check-item.checked-anat').forEach(function(item) {
      (item.dataset.cats||'').split(' ').forEach(function(c){if(cats[c]!==undefined)cats[c]++;});
    });
    var t = 0.5;
    var anat = (cats.anatomy/(totals.anatomy||1)) >= t;
    var histo = (cats.histo/(totals.histo||1)) >= t && (cats.cells/(totals.cells||1)) >= t;
    var neural = (cats.neural/(totals.neural||1)) >= t;
    var func = (cats.function/(totals.function||1)) >= t;
    var all = panel.querySelectorAll('.check-item.checked-anat').length / (panel.querySelectorAll('.check-item').length||1);
    var effort = all >= t;
    ['rpAnat','rpHisto','rpNeural','rpFunc','rpVisual','rpAccuracy'].forEach(function(id){
      document.getElementById(id).classList.remove('met');
    });
    if(anat) document.getElementById('rpAnat').classList.add('met');
    if(histo) document.getElementById('rpHisto').classList.add('met');
    if(neural) document.getElementById('rpNeural').classList.add('met');
    if(func) document.getElementById('rpFunc').classList.add('met');
    if(effort) document.getElementById('rpVisual').classList.add('met');
    if(effort&&anat&&histo) document.getElementById('rpAccuracy').classList.add('met');
  }

  updateProgress();
</script>
